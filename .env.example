# ---------------------------------------------------------------------------
# AI Receptionist - environment variables
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
ENV=local
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:3000
SECRET_KEY=

# --- LiveKit ----------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=ai-receptionist
LIVEKIT_SIP_TRUNK_ID=

# --- Telephony (Exotel / Plivo) --------------------------------------------
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_NUMBER=

# --- Sarvam AI (STT/TTS) ----------------------------------------------------
SARVAM_API_KEY=
SARVAM_STT_LANGUAGE=unknown
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_LANGUAGE=hi-IN
SARVAM_TIMEOUT_SECONDS=10

# --- Deepgram (English STT fallback) ---------------------------------------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
DEEPGRAM_TIMEOUT_SECONDS=10

# --- LLM --------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=15

# --- Google Calendar --------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_TIMEOUT_SECONDS=10

# --- WhatsApp / SMS ---------------------------------------------------------
WHATSAPP_PROVIDER=meta
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=
SMS_PROVIDER=exotel

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=receptionist
POSTGRES_PASSWORD=receptionist_dev_password
POSTGRES_DB=receptionist
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://receptionist:receptionist_dev_password@localhost:5432/receptionist

# --- Redis / Arq ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
ARQ_QUEUE_NAME=post_call

# --- S3-compatible storage (recordings) ------------------------------------
S3_ENDPOINT_URL=
S3_REGION=ap-south-1
S3_BUCKET=ai-receptionist-recordings
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
S3_TIMEOUT_SECONDS=30

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Clinic defaults --------------------------------------------------------
CLINIC_ID=
CLINIC_NAME=Aarogya Clinic
CLINIC_TIMEZONE=Asia/Kolkata
DEFAULT_LANGUAGE=hi-IN
TRANSFER_NUMBER=
RECORDING_CONSENT_REQUIRED=true
