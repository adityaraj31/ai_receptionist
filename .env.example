# ---------------------------------------------------------------------------
# AI Receptionist - environment variables
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
ENV=local
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:3000
# Signs staff JWT access tokens. Use a long random value in production.
SECRET_KEY=

# --- LiveKit ----------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=ai-receptionist
LIVEKIT_SIP_TRUNK_ID=

# --- Telephony (Exotel / Plivo) --------------------------------------------
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_NUMBER=

# --- Sarvam AI (STT/TTS) ----------------------------------------------------
SARVAM_API_KEY=
SARVAM_STT_LANGUAGE=unknown
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_LANGUAGE=hi-IN
SARVAM_TIMEOUT_SECONDS=10

# --- Deepgram (English STT fallback) ---------------------------------------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
DEEPGRAM_TIMEOUT_SECONDS=10

# --- LLM --------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=15

# --- Google Calendar --------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_TIMEOUT_SECONDS=10

# --- WhatsApp / SMS ---------------------------------------------------------
WHATSAPP_PROVIDER=meta
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=
SMS_PROVIDER=exotel

# --- Demo seed --------------------------------------------------------------
# Required to run `python -m scripts.seed`. Use long random values; never commit them.
DEMO_STAFF_EMAIL=admin@demo-clinic.example.com
DEMO_STAFF_PASSWORD=
DEMO_AGENT_KEY=

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=receptionist
POSTGRES_PASSWORD=change-me
POSTGRES_DB=receptionist
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Required. Never commit real credentials. For Supabase/Neon, paste the plain
# connection string; the API converts it to asyncpg and extracts sslmode automatically.
DATABASE_URL=postgresql+asyncpg://receptionist:change-me@localhost:5432/receptionist
# Optional. Tests default to a local *_test database built from POSTGRES_*.
# Never point tests at the production DATABASE_URL.
# TEST_DATABASE_URL=postgresql+asyncpg://receptionist:change-me@localhost:5432/receptionist_test

# --- Redis / Arq ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
ARQ_QUEUE_NAME=post_call

# --- S3-compatible storage (recordings) ------------------------------------
S3_ENDPOINT_URL=
S3_REGION=ap-south-1
S3_BUCKET=ai-receptionist-recordings
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
S3_TIMEOUT_SECONDS=30

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Clinic defaults --------------------------------------------------------
# Leave empty to use the first active clinic in Postgres. Set a UUID to pin one clinic.
CLINIC_ID=
# The values below are only used when DATABASE_URL is empty or the DB has no clinic.
CLINIC_NAME=Aarogya Clinic
CLINIC_TIMEZONE=Asia/Kolkata
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_FEES=General consultation: INR 500
CLINIC_EMERGENCY_NUMBER=108
# JSON list. Each item can be a name string or {"name","specialty","days","hours"}.
CLINIC_DOCTORS='[{"name":"Dr. Asha Rao","specialty":"General Physician","days":"Mon, Wed, Fri","hours":"10:00-13:00"},{"name":"Dr. Vikram Shah","specialty":"Pediatrics","days":"Tue, Thu, Sat","hours":"16:00-19:00"}]'
# JSON object mapping weekday to opening hours.
CLINIC_TIMINGS='{"Monday":"09:00-18:00","Tuesday":"09:00-18:00","Wednesday":"09:00-18:00","Thursday":"09:00-18:00","Friday":"09:00-18:00","Saturday":"09:00-14:00","Sunday":"Closed"}'
DEFAULT_LANGUAGE=hi-IN
TRANSFER_NUMBER=
RECORDING_CONSENT_REQUIRED=true
