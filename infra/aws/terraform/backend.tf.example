# Copy to backend.tf after creating the state bucket and lock table, then run
# terraform init -migrate-state. Never commit backend.tf if it contains account ids.
terraform {
  backend "s3" {
    bucket         = "your-terraform-state-bucket"
    key            = "ai-receptionist/prod/terraform.tfstate"
    region         = "ap-south-1"
    dynamodb_table = "terraform-locks"
    encrypt        = true
  }
}
